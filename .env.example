# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.

# --- Provider (EntitySport) ---
ENTITY_TOKEN=put-your-token-here
# ENTITY_REST_BASE=https://restapi.entitysport.com/exchange
# ENTITY_WS_URL=ws://webhook.entitysport.com:8087/connect
PROVIDER_MAX_CALLS_PER_MINUTE=30

# --- Local services (match docker-compose.yml) ---
DATABASE_URL=postgresql://cricket:cricket@localhost:5432/cricket
REDIS_URL=redis://localhost:6379

# --- Firebase (needed for live data; without these the live service prints to the console) ---
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT=secrets/firebase-service-account.json

# --- API ---
# PORT=3000
# API_HOST=0.0.0.0
# API_RATE_LIMIT_PER_MINUTE=120
# API_CORS_ORIGINS=*                 # comma-separated origins; set this in production
# API_DOCS_ENABLED=true              # false hides Swagger UI at /docs
# API_TRUST_PROXY=false              # true, a number of proxies (e.g. 1), or proxy IPs; only behind a proxy you control

# --- Other ---
# SYNC_PER_PAGE=50
# CAPTURE_DIR=captures
